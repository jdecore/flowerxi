---
import '../styles/index.css';
import '../styles/typography.css';

// Componentes
import StartupRegionModalReact from '../islands-react/StartupRegionModalReact.tsx';
import OperationalHeroReact from '../islands-react/OperationalHeroReact.tsx';
import EvidenceChartsReact from '../islands-react/EvidenceChartsReact.tsx';
import RiskHeatmapReact from '../islands-react/RiskHeatmapReact.tsx';
import CommercialReact from '../islands-react/CommercialReact.tsx';

import SabanaComparisonReact from '../islands-react/SabanaComparisonReact.tsx';
import ClosestStationReact from '../islands-react/ClosestStationReact.tsx';
import ChatBotReact from '../islands-react/ChatBotReact.tsx';


---

<html lang="es">
   <head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1" />
     <title>flowerxi | Dashboard Agroclimático</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
   </head>
  <body>
    <div class="app-root">
      <!-- Topbar -->
      <header class="topbar">
        <div class="topbar-start">
          <div class="brand">🌺 flowerxi</div>
          <span class="brand-sub">Sabana de Bogotá • Flores de corte</span>
        </div>
         <div class="topbar-end">
           <button class="btn-primary-nav" type="button" data-region-trigger aria-label="Cambiar municipio">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg>
             <span id="current-region">Madrid</span>
             <span class="chev">▾</span>
           </button>
            <button class="btn-icon" id="btn-refresh" title="Actualizar" aria-label="Actualizar">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
           </button>
         </div>
      </header>

      <StartupRegionModalReact client:load />

      <!-- Layout principal -->
      <div class="main-layout">
        <main class="main-col">
          <!-- Top row: Inteligencia Agroclimática (izq) + Card Operativa (der) -->
          <div class="hero-about-row">
            <div class="help-text-block">
              <span class="hero-tag-text">Plataforma Operativa de Floricultura</span>
              <h1 class="help-title">Inteligencia Agroclimática para Flor de Corte</h1>
              <p class="help-lead">Protege tu producción de exportación con decisiones preventivas diarias en la Sabana de Bogotá.</p>
              <p class="help-text">
                Flowerxi modela el microclima en tiempo real para anticipar la esporulación de hongos y el estrés hídrico en invernadero antes de que afecten la calidad de tus tallos.
              </p>
              <ul class="help-list">
                <li>
                  <strong>🎯 Ventana Crítica de Ventilación:</strong> Identifica las horas exactas de condensación foliar para ajustar cortinas en tu municipio.
                </li>
                <li>
                  <strong>🛡️ Prevención de Botrytis & Oídio:</strong> Reduce mermas y rechazos en poscosecha mediante alertas fitosanitarias tempranas.
                </li>
                <li>
                  <strong>📊 Modelado Dinámico a 14 Días:</strong> Evalúa el comportamiento histórico y proyecciones de riesgo acumulado en tu zona.
                </li>
              </ul>
            </div>
            <section class="hero-shell">
              <OperationalHeroReact initialRegion="madrid" client:load />
            </section>
          </div>

          <!-- Resumen automático — solo LFM2.5 local -->
          <div class="chat-full" id="chat-anchor">
            <ChatBotReact client:idle={{ timeout: 600 }} />
          </div>

          <!-- Evidencia en vivo — React + Recharts -->
          <section class="evidence-shell">
            <h2 class="section-head">Evidencia en vivo</h2>
            <p class="section-sub">Últimos 14 días — React + Recharts, gradientes slate/teal</p>
            <EvidenceChartsReact initialRegion="madrid" client:visible />
          </section>

          <!-- Calendario 12m — React -->
          <div class="one-col-row">
            <RiskHeatmapReact region="madrid" client:visible />
          </div>

          <!-- Comercial — React -->
          <div class="one-col-row">
            <CommercialReact client:visible />
          </div>

          <!-- Contexto Sabana — React -->
          <div class="one-col-row">
            <section class="comparison-card">
              <h3 class="section-head">Comparativa Sabana</h3>
              <SabanaComparisonReact initialRegion="madrid" client:visible />
            </section>
          </div>

          <div class="one-col-row station-row">
            <section class="station-card">
              <h3 class="section-head">Estación de referencia</h3>
              <ClosestStationReact initialRegion="madrid" client:visible />
              <p class="made-by">Hecho por Juan Enriquez- 2026 • React islands + Recharts • LFM2.5 local</p>
            </section>
          </div>
        </main>
      </div>

      <!-- Scripts vanilla para refresh y municipio -->
      <script>
        if (typeof window !== 'undefined') {
          // Abrir selector de municipio
          const openRegionSelector = () => {
            window.dispatchEvent(new Event('open-region-selector'));
          };
          document.querySelectorAll('[data-region-trigger]').forEach((trigger) => {
            trigger.addEventListener('click', openRegionSelector);
          });

          const regionNameFromSlug = (slug) => {
            const value = String(slug || '').trim();
            if (!value) return 'Madrid';
            const labels = {
              madrid: 'Madrid',
              facatativa: 'Facatativá',
              funza: 'Funza',
              'el-rosal': 'El Rosal',
              tocancipa: 'Tocancipá',
              chia: 'Chía',
              mosquera: 'Mosquera',
              sopo: 'Sopó',
              bojaca: 'Bojacá',
              cachipay: 'Cachipay',
            };
            if (labels[value]) return labels[value];
            return value
              .split('-')
              .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
              .join(' ');
          };

          const regionLabel = document.getElementById('current-region');
          const syncCurrentRegion = (slug) => {
            if (!regionLabel) return;
            regionLabel.textContent = regionNameFromSlug(slug);
          };

           syncCurrentRegion(localStorage.getItem('flowerxi_region') || 'madrid');
          window.addEventListener('regionchange', (event) => {
            const slug = event?.detail || localStorage.getItem('flowerxi_region') || 'madrid';
            syncCurrentRegion(slug);
          });

          // Refresh datos
          document.getElementById('btn-refresh')?.addEventListener('click', () => {
            window.__flowerxiForceFreshUntil = Date.now() + 1500;
            window.dispatchEvent(new Event('refreshdata'));
            window.dispatchEvent(new Event('flowerxi:refresh'));
          });
        }
      </script>
    </div>

    <style>
      .app-root { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg-app); }

      /* Topbar */
      .topbar {
        position: sticky; top: 0; z-index: 50;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-subtle);
        padding: 0.75rem 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; box-shadow: var(--shadow-sm);
      }
      .topbar-start { display: flex; align-items: center; gap: 0.7rem; min-width: 0; flex-wrap: wrap; }
      .brand { font-family: var(--font-sans); font-weight: 700; font-size: 1.25rem; color: var(--primary); letter-spacing: -0.02em; }
      .brand-sub { font-size: 0.75rem; color: var(--text-tertiary); font-weight: 500; letter-spacing: 0.02em; }
      .topbar-end { display: flex; align-items: center; gap: 0.5rem; }
      .btn-primary-nav {
        display: inline-flex; align-items: center; gap: 0.4rem;
        border: 1px solid var(--primary); border-radius: 999px;
        background: var(--primary); color: #fff;
        padding: 0.5rem 0.95rem; font-family: var(--font-sans); font-size: 0.875rem; font-weight: 600;
        cursor: pointer; transition: all 150ms; white-space: nowrap;
      }
      .btn-primary-nav:hover { background: var(--primary-hover); transform: translateY(-1px); }
      .chev { font-size: 10px; opacity: 0.9; }
      .btn-icon {
        width: 38px; height: 38px; display: grid; place-items: center;
        border: 1px solid var(--border-subtle); background: var(--bg-surface);
        color: var(--text-secondary); border-radius: 10px;
        cursor: pointer; transition: all 150ms;
      }
      .btn-icon:hover { background: var(--bg-muted); color: var(--primary); border-color: var(--border-medium); }

      /* Layout */
      .main-layout { padding: 1.5rem; max-width: 1280px; margin: 0 auto; width: 100%; }
      .main-col { display: flex; flex-direction: column; gap: 1.25rem; }

      /* Hero + Help texto plano izquierda */
      .hero-about-row { display: grid; grid-template-columns: 0.9fr 1.4fr; gap: 2rem; align-items: start; }
      .hero-shell { display: grid; gap: 0; min-width: 0; }
      .help-text-block { display: grid; gap: 14px; padding: 12px 0; align-content: center; min-height: 340px; }
      .help-title {
        margin: 0; font-family: "Times New Roman", Times, Georgia, serif;
        font-size: 2.15rem; font-weight: 700; line-height: 1.12; letter-spacing: -0.03em; color: #0f172a;
      }
      .help-lead { margin: 0; font-family: var(--font-sans); font-size: 1.1rem; font-weight: 600; color: var(--primary); }
      .help-text { margin: 0; font-family: var(--font-sans); font-size: 1.05rem; line-height: 1.6; color: #334155; }
      .help-list { margin: 0; padding-left: 20px; display: grid; gap: 8px; font-family: var(--font-sans); font-size: 0.95rem; color: #334155; line-height: 1.6; }
      .help-list li::marker { color: var(--primary); }
      .help-foot { margin: 0; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-tertiary); border-top: 1px solid var(--border-subtle); padding-top: 12px; line-height: 1.5; }

      .chat-full { display: grid; gap: 0.6rem; }
      .chat-protagonist {
        background: var(--bg-surface); border: 1px solid var(--border-subtle);
        border-radius: 16px; padding: 1rem; box-shadow: var(--shadow-sm); display: grid; gap: 0.6rem;
      }
      .evidence-shell {
        background: var(--bg-surface); border: 1px solid var(--border-subtle);
        border-radius: 16px; padding: 1.25rem; box-shadow: var(--shadow-sm);
      }
      .section-head { margin: 0 0 0.35rem 0; font-family: var(--font-sans); font-size: 1.05rem; font-weight: 600; color: var(--text-primary); }
      .section-sub { margin: 0 0 0.9rem; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-tertiary); line-height: 1.5; }

      .one-col-row { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
      .comparison-card {
        background: var(--bg-surface); border: 1px solid var(--border-subtle);
        border-radius: 16px; box-shadow: var(--shadow-sm); padding: 1.25rem; min-height: 480px; display: grid; gap: 0.75rem;
      }
      .station-card {
        background: var(--bg-surface); border: 1px solid var(--border-subtle);
        border-radius: 16px; box-shadow: var(--shadow-sm); padding: 1.25rem; display: grid; gap: 0.5rem;
      }
      .station-row { margin-top: 0.25rem; }
      .made-by { margin: 0; font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-tertiary); }

      /* Responsive */
      @media (max-width: 1024px) {
        .hero-about-row { grid-template-columns: 1fr; }
      }
      @media (max-width: 768px) {
        .main-layout { padding: 1rem; }
        .topbar { padding: 0.6rem 1rem; flex-wrap: wrap; }
        .brand-sub { display: none; }
        .help-title { font-size: 1.35rem; }
      }
    </style>
  </body>
</html>
