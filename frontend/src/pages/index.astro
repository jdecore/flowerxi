---
import '../styles/index.css';
import '../styles/typography.css';

// Componentes
import StartupRegionModalReact from '../islands-react/StartupRegionModalReact.tsx';
import OperationalHeroReact from '../islands-react/OperationalHeroReact.tsx';
import EvidenceChartsReact from '../islands-react/EvidenceChartsReact.tsx';
import RiskHeatmapReact from '../islands-react/RiskHeatmapReact.tsx';
import ImpactoOperacionReact from '../islands-react/ImpactoOperacionReact.tsx';
import CommercialReact from '../islands-react/CommercialReact.tsx';
import SabanaComparisonReact from '../islands-react/SabanaComparisonReact.tsx';
import ClosestStationReact from '../islands-react/ClosestStationReact.tsx';
import ChatBotReact from '../islands-react/ChatBotReact.tsx';

---

<html lang="es">
   <head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1" />
     <title>flowerxi | Dashboard Agroclimático</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">
   </head>
  <body>
    <div class="app-root">
      <!-- Topbar -->
      <header class="topbar">
        <div class="topbar-start">
          <div class="brand">🌺 flowerxi</div>
          <span class="brand-sub">Sabana de Bogotá • Flores de corte</span>
        </div>
         <div class="topbar-end">
           <button class="btn-primary-nav" type="button" data-region-trigger aria-label="Cambiar municipio">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="3"/></svg>
             <span id="current-region">Madrid</span>
             <span class="chev">▾</span>
           </button>
            <button class="btn-icon" id="btn-refresh" title="Actualizar" aria-label="Actualizar">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
           </button>
         </div>
      </header>

      <StartupRegionModalReact client:load />

      <!-- Layout principal -->
      <div class="main-layout">
        <main class="main-col">
          <!-- Top row: Hero (izq) + Ayuda editorial (der) -->
          <div class="hero-about-row">
            <section class="hero-shell">
              <p class="hero-shell-kicker">🌹 Flowerxi operativo</p>
              <p class="hero-shell-sub">Lectura en tiempo real para el municipio actual. Baja para ver evidencia y acción.</p>
              <OperationalHeroReact initialRegion="madrid" client:load />
            </section>
            <aside class="help-card">
              <h2 class="help-title">¿En qué te ayuda Flowerxi?</h2>
              <p class="help-lead">Decide en segundos, sin adivinar.</p>
              <p class="help-text">
                Flowerxi traduce el clima de la Sabana (Open-Meteo) en <strong>qué hacer hoy</strong> en tu municipio: si ventilar, drenar o inspeccionar para evitar botritis y pérdidas.
              </p>
              <ul class="help-list">
                <li><strong>Ahorra tiempo:</strong> score operativo y ventana crítica al abrir.</li>
                <li><strong>Reduce riesgo:</strong> alerta temprana de encharcamiento y hongos.</li>
                <li><strong>Te guía:</strong> cada gráfica explica la acción — baja y el tablero te lleva paso a paso.</li>
              </ul>
              <p class="help-foot">Elige municipio arriba y recorre el flujo. El chat local te explica cualquier dato sin salir de la página.</p>
            </aside>
          </div>

          <!-- Chat protagonista — ahora full width debajo del hero/about -->
          <div class="chat-full" id="chat-anchor">
            <div class="chat-protagonist">
              <h2 class="section-head">Chat IA local (React)</h2>
              <p class="section-sub">LFM2.5-230M en tu navegador — ligero con Recharts + Transformers.js</p>
              <ChatBotReact embedded={true} client:idle={{ timeout: 600 }} />
            </div>
          </div>

          <!-- Evidencia en vivo — React + Recharts -->
          <section class="evidence-shell">
            <h2 class="section-head">Evidencia en vivo</h2>
            <p class="section-sub">Últimos 14 días — React + Recharts, gradientes slate/teal</p>
            <EvidenceChartsReact initialRegion="madrid" client:visible />
          </section>

          <!-- Calendario 12m — React -->
          <div class="one-col-row">
            <RiskHeatmapReact region="madrid" client:visible />
          </div>

          <!-- Impacto 7d — React -->
          <div class="one-col-row">
            <ImpactoOperacionReact initialRegion="madrid" client:visible />
          </div>

          <!-- Comercial — React -->
          <div class="one-col-row">
            <CommercialReact client:visible />
          </div>

          <!-- Contexto Sabana — React -->
          <div class="one-col-row">
            <section class="comparison-card">
              <h3 class="section-head">Comparativa Sabana (React)</h3>
              <SabanaComparisonReact initialRegion="madrid" client:visible />
            </section>
          </div>

          <div class="one-col-row station-row">
            <section class="station-card">
              <h3 class="section-head">Estación de referencia (React)</h3>
              <ClosestStationReact initialRegion="madrid" client:visible />
              <p class="made-by">Hecho por Juan Enriquez- 2026 • React islands + Recharts • LFM2.5 local</p>
            </section>
          </div>
        </main>
      </div>

      <!-- Scripts vanilla para refresh y municipio -->
      <script>
        if (typeof window !== 'undefined') {
          // Abrir selector de municipio
          const openRegionSelector = () => {
            window.dispatchEvent(new Event('open-region-selector'));
          };
          document.querySelectorAll('[data-region-trigger]').forEach((trigger) => {
            trigger.addEventListener('click', openRegionSelector);
          });

          const regionNameFromSlug = (slug) => {
            const value = String(slug || '').trim();
            if (!value) return 'Madrid';
            const labels = {
              madrid: 'Madrid',
              facatativa: 'Facatativá',
              funza: 'Funza',
              'el-rosal': 'El Rosal',
              tocancipa: 'Tocancipá',
              chia: 'Chía',
              mosquera: 'Mosquera',
              sopo: 'Sopó',
              bojaca: 'Bojacá',
              cachipay: 'Cachipay',
            };
            if (labels[value]) return labels[value];
            return value
              .split('-')
              .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
              .join(' ');
          };

          const regionLabel = document.getElementById('current-region');
          const syncCurrentRegion = (slug) => {
            if (!regionLabel) return;
            regionLabel.textContent = regionNameFromSlug(slug);
          };

           syncCurrentRegion(localStorage.getItem('flowerxi_region') || 'madrid');
          window.addEventListener('regionchange', (event) => {
            const slug = event?.detail || localStorage.getItem('flowerxi_region') || 'madrid';
            syncCurrentRegion(slug);
          });

          // Refresh datos
          document.getElementById('btn-refresh')?.addEventListener('click', () => {
            window.__flowerxiForceFreshUntil = Date.now() + 1500;
            window.dispatchEvent(new Event('refreshdata'));
            window.dispatchEvent(new Event('flowerxi:refresh'));
          });
        }
      </script>
    </div>

    <style>
      /* App root */
      .app-root { min-height: 100vh; display: flex; flex-direction: column; }

      /* Topbar */
      .topbar {
        position: sticky; top: 0; z-index: 50;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 1.5rem;
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; box-shadow: var(--shadow);
      }
      .topbar-start { display: flex; align-items: center; gap: 0.7rem; min-width: 0; flex-wrap: wrap; }
      .brand {
        font-family: var(--font-sans);
        font-weight: var(--font-bold);
        font-size: var(--text-2xl);
        color: var(--primary);
      }
      .brand-sub { font-size: var(--text-sm); color: var(--text-tertiary); font-weight: var(--font-medium); }
      .topbar-end { display: flex; align-items: center; gap: 0.5rem; }
      .btn-primary-nav {
        display: inline-flex; align-items: center; gap: 0.4rem;
        border: 1px solid var(--primary); border-radius: 999px;
        background: var(--primary); color: #fff;
        padding: 0.5rem 0.85rem;
        font-family: var(--font-sans); font-size: var(--text-base); font-weight: var(--font-semibold);
        cursor: pointer; transition: all 150ms;
      }
      .btn-primary-nav:hover { background: var(--primary-hover); }
      .chev { font-size: 10px; }
      .btn-icon {
        padding: 0.5rem; border: none; background: var(--bg-app);
        color: var(--text-secondary); border-radius: var(--radius);
        font-family: var(--font-sans);
        cursor: pointer; transition: all 150ms;
      }
      .btn-icon:hover { background: var(--border); color: var(--primary); }
      .btn-region-trigger {
        display: inline-flex; align-items: center; gap: 0.35rem;
        border: none; border-radius: 999px;
        background: var(--primary, #7b5ba6); color: #fff;
        padding: 0.46rem 0.72rem;
        font-family: var(--font-sans); font-size: var(--text-base); font-weight: var(--font-semibold);
        cursor: pointer;
      }
      .btn-region-trigger:hover { background: var(--primary-hover, #6b4f92); }
      .btn-region-trigger span { line-height: 1; }

      /* hero + help editorial + chat */
      .hero-about-row {
        display: grid; grid-template-columns: 1.45fr 0.85fr;
        gap: 1.25rem; align-items: start;
      }
      .help-card {
        background: #fff; border: 1px solid var(--border-subtle); border-radius: 16px;
        padding: 18px; box-shadow: var(--shadow-sm); position: sticky; top: 74px;
        display: grid; gap: 10px;
      }
      .help-title {
        margin: 0; font-family: "Times New Roman", Times, Georgia, serif;
        font-size: 26px; font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; color: #0f172a;
      }
      .help-lead { margin: 0; font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: #0f766e; }
      .help-text { margin: 0; font-family: var(--font-sans); font-size: 14px; line-height: 1.55; color: #334155; }
      .help-list { margin: 0; padding-left: 18px; display: grid; gap: 6px; font-family: var(--font-sans); font-size: 13px; color: #334155; }
      .help-list li::marker { color: #0f766e; }
      .help-foot { margin: 0; font-family: var(--font-sans); font-size: 12px; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 8px; }
      .chat-full { display: grid; gap: 0.6rem; }
      .chat-protagonist {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        padding: 1rem;
        box-shadow: var(--shadow-sm);
        display: grid; gap: 0.6rem;
      }
      .evidence-shell {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        padding: 1.25rem;
        box-shadow: var(--shadow-sm);
      }

      /* Layout principal */
      .main-layout { padding: 1.5rem; max-width: 1280px; margin: 0 auto; width: 100%; }
      .main-col { display: flex; flex-direction: column; gap: 1.25rem; }
      .hero-shell {
        display: grid;
        gap: 0.5rem;
      }
      .hero-shell-kicker {
        margin: 0;
        width: max-content;
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        font-weight: var(--font-semibold);
        color: #fff;
        border-radius: 999px;
        padding: 0.24rem 0.62rem;
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
      }
      .hero-shell-sub {
        margin: -0.05rem 0 0.1rem;
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        color: var(--text-tertiary);
      }

      /* legacy dashboard-12 removed */

      .section-head {
        margin: 0 0 0.4rem 0;
        font-family: var(--font-sans);
        font-size: var(--text-xl);
        font-weight: var(--font-semibold);
        color: var(--text-primary);
      }
      .section-sub {
        margin: 0.2rem 0 0.8rem;
        font-family: var(--font-sans);
        font-size: var(--text-base);
        color: var(--text-tertiary);
      }

      /* Filas 2 columnas */
      .two-col-row {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
      }
      .one-col-row {
        display: grid; grid-template-columns: 1fr;
        gap: 1.25rem;
      }

      .comparison-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px; box-shadow: var(--shadow-sm);
        padding: 1.25rem; min-height: 520px;
        display: grid; gap: 0.75rem;
      }

      .station-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: 14px; box-shadow: var(--shadow-sm);
        padding: 1.25rem; display: grid; gap: 0.5rem;
      }
      .station-row { margin-top: 0.35rem; }
      .made-by {
        margin: 0.2rem 0 0;
        font-family: var(--font-sans);
        font-size: var(--text-sm);
        color: var(--text-tertiary, #94a3b8);
      }

      /* Responsive móvil */
      @media (max-width: 1024px) {
        .two-col-row { grid-template-columns: 1fr; }
      }
      @media (max-width: 1024px) {
        .hero-about-row { grid-template-columns: 1fr; }
        .help-card { position: static; }
      }
      @media (max-width: 768px) {
        .main-layout { padding: 1rem; }
        .topbar { padding: 0.6rem 1rem; }
        .hero-shell-sub { margin-top: 0; }
        .topbar-end { flex: 1; justify-content: flex-end; }
      }
    </style>
  </body>
</html>
